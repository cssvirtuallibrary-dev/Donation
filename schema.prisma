datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Pledge {
  id             String    @id @default(cuid())
  donorName      String
  donorContact   String?
  amountPledged  Decimal   @db.Decimal(10, 2)
  amountReceived Decimal   @default(0) @db.Decimal(10, 2)
  paymentMethod  String    // "venmo" | "cash"
  status         String    @default("pledged") // pledged | partially_received | received | cancelled
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  confirmedAt    DateTime?
}
